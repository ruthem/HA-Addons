#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the OpenClaw Gateway
# ==============================================================================

set -euo pipefail

WORKSPACE_PATH=$(bashio::config 'workspace_path')
VERBOSE=$(bashio::config 'verbose')

STATE_DIR="${WORKSPACE_PATH}/.openclaw"
CONFIG_PATH="${STATE_DIR}/openclaw.json"

mkdir -p "${WORKSPACE_PATH}" "${STATE_DIR}"

export HOME="${WORKSPACE_PATH}"
export CI=true
export OPENCLAW_STATE_DIR="${STATE_DIR}"
export OPENCLAW_CONFIG_PATH="${CONFIG_PATH}"
export OPENCLAW_NO_RESPAWN=1

bashio::log.info "OpenClaw Gateway starting"
bashio::log.info "Workspace: ${WORKSPACE_PATH}"

# Build args array
ALLOW_UNCONFIGURED=false

# Setup on first run
if [ ! -f "${CONFIG_PATH}" ]; then
  bashio::log.notice "First run — setting up OpenClaw..."
  openclaw setup --workspace "${WORKSPACE_PATH}"

  # Generate auth token if missing
  if jq -e '(.gateway.auth.token // "") | length == 0' "${CONFIG_PATH}" >/dev/null 2>&1; then
    TOKEN=$(node -e "const crypto=require('crypto');process.stdout.write(crypto.randomBytes(24).toString('hex'));")
    jq --arg token "${TOKEN}" \
      '.gateway = (.gateway // {}) | .gateway.auth = (.gateway.auth // {}) | .gateway.auth.token = $token | .gateway.auth.mode = (.gateway.auth.mode // "token")' \
      "${CONFIG_PATH}" > tmp.json && mv tmp.json "${CONFIG_PATH}"
    bashio::log.notice "Gateway Auth Token: ${TOKEN}"
  fi
  ALLOW_UNCONFIGURED=true
elif ! jq -e '(.gateway.mode // "") | length > 0' "${CONFIG_PATH}" >/dev/null 2>&1; then
  bashio::log.info "Config exists but gateway.mode not set — allowing unconfigured"
  ALLOW_UNCONFIGURED=true
else
  bashio::log.info "Config fully configured"
fi

# Start gateway
ARGS=(gateway)

if [ "${ALLOW_UNCONFIGURED}" = "true" ]; then
  ARGS+=(--allow-unconfigured)
fi

if [ "${VERBOSE}" = "true" ]; then
  ARGS+=(--verbose)
fi

bashio::log.info "Starting OpenClaw Gateway..."
exec openclaw "${ARGS[@]}"